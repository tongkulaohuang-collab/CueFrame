{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "frames": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "time": {
            "type": "number"
          },
          "caption": {
            "type": "string"
          },
          "poses": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,60}$",
                  "minLength": 1,
                  "maxLength": 60
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "rotation": {
                  "type": "number"
                },
                "scaleX": {
                  "type": "number"
                },
                "scaleY": {
                  "type": "number"
                },
                "opacity": {
                  "type": "number"
                }
              },
              "required": [
                "id",
                "x",
                "y",
                "rotation",
                "scaleX",
                "scaleY",
                "opacity"
              ]
            }
          },
          "camera": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "zoom": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "zoom"
            ]
          },
          "sceneId": {
            "type": "string"
          }
        },
        "required": [
          "time",
          "caption",
          "poses",
          "camera",
          "sceneId"
        ]
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "bg": {
            "type": "string"
          },
          "subjectId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,60}$",
            "minLength": 1,
            "maxLength": 60
          },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 160,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,60}$",
                  "minLength": 1,
                  "maxLength": 60
                },
                "paths": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "d": {
                        "type": "string"
                      },
                      "fill": {
                        "type": "string"
                      },
                      "stroke": {
                        "type": "string"
                      },
                      "strokeWidth": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "d",
                      "fill",
                      "stroke",
                      "strokeWidth"
                    ]
                  },
                  "maxItems": 100
                }
              },
              "required": [
                "id",
                "paths"
              ]
            }
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,60}$",
            "minLength": 1,
            "maxLength": 60
          },
          "actors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,60}$",
                  "minLength": 1,
                  "maxLength": 60
                },
                "designId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,60}$",
                  "minLength": 1,
                  "maxLength": 60
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "rootId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,60}$",
                  "minLength": 1,
                  "maxLength": 60,
                  "description": "根节点编号，必须等于本主体中 parentPartId 为 null 的部件 nodeId。"
                },
                "contentType": {
                  "type": "string",
                  "enum": [
                    "object",
                    "text",
                    "person-image",
                    "person-symbol"
                  ]
                },
                "capability": {
                  "type": "string",
                  "enum": [
                    "rigid",
                    "articulated"
                  ]
                },
                "style": {
                  "type": "object",
                  "properties": {
                    "silhouette": {
                      "type": "string"
                    },
                    "proportions": {
                      "type": "string"
                    },
                    "material": {
                      "type": "string"
                    },
                    "light": {
                      "type": "string"
                    },
                    "palette": {
                      "type": "string"
                    },
                    "stroke": {
                      "type": "string"
                    },
                    "perspective": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "silhouette",
                    "proportions",
                    "material",
                    "light",
                    "palette",
                    "stroke",
                    "perspective"
                  ],
                  "additionalProperties": false
                },
                "parts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]{1,60}$",
                        "minLength": 1,
                        "maxLength": 60
                      },
                      "nodeId": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]{1,60}$",
                        "minLength": 1,
                        "maxLength": 60
                      },
                      "replaceable": {
                        "type": "boolean"
                      },
                      "pivot": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "x",
                          "y"
                        ],
                        "additionalProperties": false
                      },
                      "parentPartId": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]{1,60}$",
                            "minLength": 1,
                            "maxLength": 60
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "父部件编号，只能引用同一 actors.parts[].id，不能填 nodeId；唯一根为 null。"
                      }
                    },
                    "required": [
                      "id",
                      "nodeId",
                      "replaceable",
                      "parentPartId",
                      "pivot"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "designId",
                "version",
                "rootId",
                "contentType",
                "capability",
                "style",
                "parts"
              ],
              "additionalProperties": false
            }
          },
          "bindingVersion": {
            "type": "integer",
            "const": 2
          }
        },
        "required": [
          "bg",
          "subjectId",
          "nodes",
          "id",
          "actors",
          "bindingVersion"
        ]
      }
    }
  },
  "required": [
    "scenes",
    "frames"
  ]
}
